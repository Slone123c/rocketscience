{
  "name": "rocketscience",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh scripts/build-helper.sh && GOFLAGS=-tags=with_gvisor mygo dev",
    "build": "bun scripts/build-macos.ts",
    "build:release": "bun scripts/build-release.ts",
    "scan:artifact": "bun scripts/scan-release-artifact.ts",
    "verify:release": "bun scripts/verify-release-artifact.ts",
    "install:app": "bun scripts/install-macos.ts",
    "collect:licenses": "bun scripts/collect-licenses.ts",
    "verify:bundle": "bun scripts/verify-bundle.ts",
    "generate": "mygo generate",
    "dev:web": "vite",
    "preview": "vite --mode preview --host 127.0.0.1 --port 4173 --strictPort",
    "build:web": "bun run verify:components && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify:components": "bun test tests/menuBarPopover.test.ts tests/tourInteraction.test.ts tests/trajectory.test.tsx tests/connectivityPresentation.test.tsx tests/profileEditorInteraction.test.ts tests/settingsNavigation.test.ts",
    "shots": "bun scripts/site-shots.ts",
    "build:demo": "vite build --mode preview --base ./ --outDir site/demo --emptyOutDir"
  },
  "dependencies": {
    "mygo-runtime": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "mygo-cli": "latest",
    "playwright-core": "^1.65.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
